<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.8" />
  </ItemGroup>

  <Target Name="PublishAot">
    <Exec Command="dotnet publish -c Release -p:PublishAot=true -p:StripSymbols=true" />
  </Target>

  <Target Name="PublishSingleFile">
    <Exec Command="dotnet publish -c Release -p:PublishSingleFile=true -p:StripSymbols=true -p:SelfContained=false" />
  </Target>
</Project>
